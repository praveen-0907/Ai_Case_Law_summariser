# .env.example for BACKEND (Node.js)
# -------------------------------------------------------
# Copy this file and rename it to ".env" (remove .example)
# Then fill in your actual values below.
# NEVER commit your real .env file to GitHub!
# -------------------------------------------------------

# Port this server runs on (default is 5000)
PORT=5000

# The URL of your frontend app (used for CORS)
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------
# SUPABASE CONFIGURATION (Optional but recommended)
# Setup instructions: see docs/SUPABASE_SETUP.md
# -------------------------------------------------------

# Supabase Project URL
# Get it from: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous API Key (public, safe to expose on frontend)
# Get it from: Supabase Dashboard → Settings → API → anon key
SUPABASE_ANON_KEY=eyJ...your-anon-key-here...

# Supabase Service Role Key (KEEP SECRET! Only for backend)
# Get it from: Supabase Dashboard → Settings → API → service_role key
# NEVER commit this to Git
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here...

# -------------------------------------------------------
# AI SERVICE CONFIGURATION
# -------------------------------------------------------

# URL where our Python AI service is running
AI_SERVICE_URL=http://localhost:8000
