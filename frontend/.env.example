# .env.example for FRONTEND
# -------------------------------------------------------
# Copy this file and rename it to ".env" (remove .example)
# Then fill in your actual values below.
# NEVER commit your real .env file to GitHub!
# -------------------------------------------------------

# -------------------------------------------------------
# SUPABASE CONFIGURATION (Optional)
# -------------------------------------------------------
# Setup instructions: see docs/SUPABASE_SETUP.md
# These allow the frontend to retrieve stored analyses.

# Supabase Project URL
# Get it from: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (public, safe to expose)
# Get it from: Supabase Dashboard → Settings → API → anon key
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key-here...

# -------------------------------------------------------
# BACKEND & AI SERVICE CONFIGURATION
# -------------------------------------------------------

# The URL where our Node.js backend is running
# During development, this will be localhost
VITE_BACKEND_URL=http://localhost:5000

# The URL where our Python AI service is running
VITE_AI_SERVICE_URL=http://localhost:8000
